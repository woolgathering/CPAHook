// SPDX-License-Identifier: BUSL-1.1
pragma solidity ^0.8.24;

import { Test } from "forge-std/Test.sol";
import { CPAAllocationPhase } from "../src/libraries/CPAAllocationPhase.sol";
import { CPAStorage } from "../src/base/CPAStorage.sol";
import { AuctionTypes } from "../src/AuctionTypes.sol";
import { BundleId, BundleIdLibrary } from "../src/BundleId.sol";
import { AllocationId, AllocationIdLibrary } from "../src/AllocationId.sol";
import { AuctionId } from "../src/AuctionId.sol";
import { PoolKey } from "@uniswap/v4-core/src/types/PoolKey.sol";
import { PoolId, PoolIdLibrary } from "@uniswap/v4-core/src/types/PoolId.sol";
import { Currency } from "@uniswap/v4-core/src/types/Currency.sol";
import { IPoolManager } from "@uniswap/v4-core/src/interfaces/IPoolManager.sol";
import { IHooks } from "@uniswap/v4-core/src/interfaces/IHooks.sol";
import { MockERC20 } from "solmate/src/test/utils/mocks/MockERC20.sol";
import { console } from "forge-std/console.sol";

// Mock pool manager that implements PriceUtils functions
contract MockPoolManager {
    // Mock price data - returns a fixed price for testing
    function getPriceOfCurrency(PoolKey memory poolKey, address currency) external pure returns (uint256) {
        // Return a mock price of 1e18 (1:1 ratio) for testing
        return 1e18;
    }
    
    // Mock slot0 data for PriceUtils
    function getSlot0(PoolId poolId) external pure returns (uint160, int24, uint24, uint24) {
        // Return mock slot0 data with sqrtPriceX96 = 2^96 (which gives price = 1)
        return (uint160(1 << 96), 0, 0, 0);
    }
}

// Simple test contract that extends CPAStorage for testing
contract TestCPAStorage is CPAStorage {
    // Additional storage mapping that matches the library signature
    mapping(AuctionId => mapping(PoolId => AuctionTypes.PoolInfo)) public auctionPoolInfo;
    
    constructor() CPAStorage(address(0x9876543210987654321098765432109876543210)) {
        // Initialize the inherited state variables
        manager = IPoolManager(address(new MockPoolManager()));
    }
    
    // Helper functions to set storage for testing
    function setAuctionInfo(AuctionId id, AuctionTypes.AuctionInfo memory info) external {
        auctionInfo[id] = info;
    }
    
    function setPoolInfo(AuctionId auctionId, PoolId poolId, AuctionTypes.PoolInfo memory info) external {
        auctionPoolInfo[auctionId][poolId] = info;
    }
    
    function setBundle(AuctionId auctionId, BundleId bundleId, AuctionTypes.Bundle memory bundle) external {
        bundles[auctionId][bundleId] = bundle;
    }
    
    // Wrapper function to call the library with proper storage references
    function submitAllocation(AuctionTypes.Allocation calldata allocationData) external {
        CPAAllocationPhase.submitAllocation(
            CPAStorage(address(this)),
            allocationData,
            topAllocation,
            auctionInfo,
            auctionPoolInfo,
            bundles
        );
    }
    
    // Wrapper function to end allocation phase
    function endAllocationPhase(AuctionId auctionId) external {
        CPAAllocationPhase.endAllocationPhase(
            topAllocation,
            auctionId
        );
    }
}

contract CPAAllocationPhaseTest is Test {
    using PoolIdLibrary for PoolKey;

    // Test data
    AuctionId public auctionId;
    address public allocator1;
    address public allocator2;
    address public numeraire;
    
    // Mock contracts
    IPoolManager public poolManager;
    MockERC20 public numeraireToken;
    MockERC20 public asset1Token;
    MockERC20 public asset2Token;
    
    // Pool keys
    PoolKey public asset1PoolKey;
    PoolKey public asset2PoolKey;
    
    // Test storage contract
    TestCPAStorage public testStorage;

    function setUp() public {
        // Set up test accounts
        auctionId = AuctionId.wrap(bytes32(uint256(1)));
        allocator1 = address(0x1111);
        allocator2 = address(0x2222);
        numeraire = address(0x3333);
        
        // Deploy mock tokens
        numeraireToken = new MockERC20("Numeraire", "NUM", 18);
        asset1Token = new MockERC20("Asset1", "AST1", 18);
        asset2Token = new MockERC20("Asset2", "AST2", 18);
        
        // Set up pool keys
        asset1PoolKey = PoolKey({
            currency0: Currency.wrap(address(asset1Token)),
            currency1: Currency.wrap(address(numeraireToken)),
            fee: 3000,
            tickSpacing: 60,
            hooks: IHooks(address(0))
        });
        
        asset2PoolKey = PoolKey({
            currency0: Currency.wrap(address(asset2Token)),
            currency1: Currency.wrap(address(numeraireToken)),
            fee: 3000,
            tickSpacing: 60,
            hooks: IHooks(address(0))
        });
        
        // Deploy test storage contract
        testStorage = new TestCPAStorage();
        
        // Initialize auction info
        _setupAuctionInfo();
        
        // Initialize pool info
        _setupPoolInfo();
        
        // Create test bundles
        _setupTestBundles();
    }

    function test_SubmitAllocation_FirstAllocation() public {
        // Create allocation data
        BundleId[] memory bundleIds = new BundleId[](2);
        bundleIds[0] = _getBundleId(1);
        bundleIds[1] = _getBundleId(2);
        
        AuctionTypes.Allocation memory allocationData = AuctionTypes.Allocation({
            auctionId: auctionId,
            allocator: allocator1,
            bundleIds: bundleIds,
            totalValue: 0,
            score: 0,
            timestamp: block.timestamp
        });
        
        // Submit allocation
        vm.prank(allocator1);
        testStorage.submitAllocation(allocationData);
        
        // Check that the allocation was recorded
        (AuctionTypes.Allocation memory allocation, uint256 score, uint256 timestamp) = testStorage.topAllocation(auctionId);
        assertEq(allocation.allocator, allocator1);
        assertEq(allocation.bundleIds.length, 2);
        assertEq(BundleId.unwrap(allocation.bundleIds[0]), BundleId.unwrap(bundleIds[0]));
        assertEq(BundleId.unwrap(allocation.bundleIds[1]), BundleId.unwrap(bundleIds[1]));
        assertGt(score, 0);
    }

    function test_SubmitAllocation_BetterAllocation() public {
        // Submit first allocation
        BundleId[] memory bundleIds1 = new BundleId[](1);
        bundleIds1[0] = _getBundleId(1);
        
        AuctionTypes.Allocation memory allocation1 = AuctionTypes.Allocation({
            auctionId: auctionId,
            allocator: allocator1,
            bundleIds: bundleIds1,
            totalValue: 0,
            score: 0,
            timestamp: block.timestamp
        });
        
        vm.prank(allocator1);
        testStorage.submitAllocation(allocation1);
        
        (, uint256 firstScore, ) = testStorage.topAllocation(auctionId);
        
        // Submit better allocation
        BundleId[] memory bundleIds2 = new BundleId[](3);
        bundleIds2[0] = _getBundleId(1);
        bundleIds2[1] = _getBundleId(2);
        bundleIds2[2] = _getBundleId(3);
        
        AuctionTypes.Allocation memory allocation2 = AuctionTypes.Allocation({
            auctionId: auctionId,
            allocator: allocator2,
            bundleIds: bundleIds2,
            totalValue: 0,
            score: 0,
            timestamp: block.timestamp
        });
        
        vm.prank(allocator2);
        testStorage.submitAllocation(allocation2);
        
        // Check that the better allocation replaced the first one
        (AuctionTypes.Allocation memory finalAllocation, uint256 finalScore, ) = testStorage.topAllocation(auctionId);
        assertEq(finalAllocation.allocator, allocator2);
        assertGt(finalScore, firstScore);
    }

    function test_SubmitAllocation_WorseAllocation() public {
        // Submit first allocation (better)
        BundleId[] memory bundleIds1 = new BundleId[](2);
        bundleIds1[0] = _getBundleId(1);
        bundleIds1[1] = _getBundleId(2);
        
        AuctionTypes.Allocation memory allocation1 = AuctionTypes.Allocation({
            auctionId: auctionId,
            allocator: allocator1,
            bundleIds: bundleIds1,
            totalValue: 0,
            score: 0,
            timestamp: block.timestamp
        });
        
        vm.prank(allocator1);
        testStorage.submitAllocation(allocation1);
        
        (, uint256 firstScore, ) = testStorage.topAllocation(auctionId);
        
        // Submit worse allocation
        BundleId[] memory bundleIds2 = new BundleId[](1);
        bundleIds2[0] = _getBundleId(1);
        
        AuctionTypes.Allocation memory allocation2 = AuctionTypes.Allocation({
            auctionId: auctionId,
            allocator: allocator2,
            bundleIds: bundleIds2,
            totalValue: 0,
            score: 0,
            timestamp: block.timestamp
        });
        
        vm.prank(allocator2);
        testStorage.submitAllocation(allocation2);
        
        // Check that the worse allocation was not accepted
        (AuctionTypes.Allocation memory finalAllocation, uint256 finalScore, ) = testStorage.topAllocation(auctionId);
        assertEq(finalAllocation.allocator, allocator1);
        assertEq(finalScore, firstScore);
    }

    function test_SubmitAllocation_InvalidBundle() public {
        // Create allocation with non-existent bundle
        BundleId[] memory bundleIds = new BundleId[](1);
        bundleIds[0] = BundleId.wrap(keccak256("non-existent-bundle"));
        
        AuctionTypes.Allocation memory allocationData = AuctionTypes.Allocation({
            auctionId: auctionId,
            allocator: allocator1,
            bundleIds: bundleIds,
            totalValue: 0,
            score: 0,
            timestamp: block.timestamp
        });
        
        // Should revert with InvalidBundle error
        vm.prank(allocator1);
        vm.expectRevert();
        testStorage.submitAllocation(allocationData);
    }

    function test_SubmitAllocation_ExceedsDeposit() public {
        // Create allocation that exceeds available deposits
        BundleId[] memory bundleIds = new BundleId[](1);
        bundleIds[0] = _getBundleId(4); // Bundle 4 has very large quantities (200, 100)
        
        AuctionTypes.Allocation memory allocationData = AuctionTypes.Allocation({
            auctionId: auctionId,
            allocator: allocator1,
            bundleIds: bundleIds,
            totalValue: 0,
            score: 0,
            timestamp: block.timestamp
        });
        
        // Should revert with InvalidBundle error (exceeds deposit)
        vm.prank(allocator1);
        vm.expectRevert();
        testStorage.submitAllocation(allocationData);
    }

    function test_EndAllocationPhase() public {
        // Submit an allocation first
        BundleId[] memory bundleIds = new BundleId[](1);
        bundleIds[0] = _getBundleId(1);
        
        AuctionTypes.Allocation memory allocation = AuctionTypes.Allocation({
            auctionId: auctionId,
            allocator: allocator1,
            bundleIds: bundleIds,
            totalValue: 0,
            score: 0,
            timestamp: block.timestamp
        });
        
        vm.prank(allocator1);
        testStorage.submitAllocation(allocation);
        
        // End allocation phase
        testStorage.endAllocationPhase(auctionId);
        
        // Check that the winner was determined
        (AuctionTypes.Allocation memory finalAllocation, , ) = testStorage.topAllocation(auctionId);
        assertEq(finalAllocation.allocator, allocator1);
    }

    // Helper functions
    function _setupAuctionInfo() internal {
        PoolKey[] memory poolKeys = new PoolKey[](2);
        poolKeys[0] = asset1PoolKey;
        poolKeys[1] = asset2PoolKey;
        
        testStorage.setAuctionInfo(auctionId, AuctionTypes.AuctionInfo({
            auctionOwner: address(this),
            commonNumeraire: address(numeraireToken),
            config: AuctionTypes.AuctionConfig({
                commonNumeraire: address(numeraireToken),
                minSpendRatio: 1000,
                dropoutSlashRatio: 1000,
                spendingViolationSlashRatio: 2000,
                maxRounds: 100,
                allocatorStakeRequirement: 10000 * 10**18,
                proxyStakeRequirement: 1000 * 10**18,
                allocationWindow: 1800,
                poolKeys: poolKeys,
                initialSqrtPricesX96: new uint160[](2),
                priceIncrements: new int24[](2)
            }),
            currentPhase: AuctionTypes.AuctionPhase.Allocation,
            currentStatus: AuctionTypes.AuctionStatus.Active,
            clockOpen: 0,
            roundBids: new AuctionTypes.Bid[](0),
            currentRound: 0,
            poolKeys: poolKeys
        }));
    }

    function _setupPoolInfo() internal {
        // Set up pool info with deposit amounts
        testStorage.setPoolInfo(auctionId, asset1PoolKey.toId(), AuctionTypes.PoolInfo({
            key: asset1PoolKey,
            startingTick: 0,
            priceIncrement: 60,
            depositAmount: 150 * 10**18, // Less than bundle 4's quantities
            excessDemand: 0,
            auctionId: auctionId
        }));
        
        testStorage.setPoolInfo(auctionId, asset2PoolKey.toId(), AuctionTypes.PoolInfo({
            key: asset2PoolKey,
            startingTick: 0,
            priceIncrement: 60,
            depositAmount: 75 * 10**18, // Less than bundle 4's quantities
            excessDemand: 0,
            auctionId: auctionId
        }));
    }

    function _setupTestBundles() internal {
        // Bundle 1: Small quantities
        uint256[] memory quantities1 = new uint256[](2);
        quantities1[0] = 50 * 10**18;
        quantities1[1] = 25 * 10**18;
        
        testStorage.setBundle(auctionId, _getBundleId(1), AuctionTypes.Bundle({
            auctionId: auctionId,
            commitHash: keccak256("bundle1"),
            value: 500 * 10**18,
            quantities: quantities1,
            timestamp: block.timestamp
        }));
        
        // Bundle 2: Medium quantities
        uint256[] memory quantities2 = new uint256[](2);
        quantities2[0] = 100 * 10**18;
        quantities2[1] = 50 * 10**18;
        
        testStorage.setBundle(auctionId, _getBundleId(2), AuctionTypes.Bundle({
            auctionId: auctionId,
            commitHash: keccak256("bundle2"),
            value: 1000 * 10**18,
            quantities: quantities2,
            timestamp: block.timestamp
        }));
        
        // Bundle 3: Large quantities
        uint256[] memory quantities3 = new uint256[](2);
        quantities3[0] = 120 * 10**18;
        quantities3[1] = 60 * 10**18;
        
        testStorage.setBundle(auctionId, _getBundleId(3), AuctionTypes.Bundle({
            auctionId: auctionId,
            commitHash: keccak256("bundle3"),
            value: 1500 * 10**18,
            quantities: quantities3,
            timestamp: block.timestamp
        }));
        
        // Bundle 4: Very large quantities (exceeds deposits)
        uint256[] memory quantities4 = new uint256[](2);
        quantities4[0] = 200 * 10**18; // Exceeds deposit of 150
        quantities4[1] = 100 * 10**18; // Exceeds deposit of 75
        
        testStorage.setBundle(auctionId, _getBundleId(4), AuctionTypes.Bundle({
            auctionId: auctionId,
            commitHash: keccak256("bundle4"),
            value: 2000 * 10**18,
            quantities: quantities4,
            timestamp: block.timestamp
        }));
    }

    function _getBundleId(uint256 bundleNumber) internal pure returns (BundleId) {
        return BundleId.wrap(keccak256(abi.encode("bundle", bundleNumber)));
    }
}